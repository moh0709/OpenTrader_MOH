########## SHARED - ##########

# Relative to packages/prisma/src
DATABASE_URL="file:../../../dev.db"
ADMIN_PASSWORD=opentrader
# Logging level for ccxt
# Accepts: "true" | ""
CCXT_VERBOSE=
# Custom HOST. Default is localhost
HOST=
# Custom port. Default is 4000
PORT=
# Path to custom strategies dir. Should be a full path.
CUSTOM_STRATEGIES_PATH=
########## SHARED END ######

########## AI ##########
# The council's provider and model are normally set from the dashboard's AI
# settings panel, which stores them in the database and applies them live. These
# are the operational limits around it, and they are read at startup.

# Stop the AI answering or acting, without touching your own controls.
# Unlike DASHBOARD_AGENT_CONTROL=off, this leaves every operator endpoint
# working — which is what you want at the moment you are cleaning up after it.
# Accepts: "1" | ""
AI_DISABLED=

# How many actions the AI may take UNATTENDED (autopilot armed) before it has to
# be re-armed, and the rolling window that applies over. The dashboard shows a
# matching countdown, but that copy lives in a browser tab; this is the one that
# decides. Default: 20 actions per 30 minutes.
AI_AUTONOMOUS_MAX_ACTIONS=
AI_AUTONOMOUS_WINDOW_MS=

# Tokens the chat may spend per UTC day. 0 (the default) means no ceiling.
# Worth setting: every message carries a fleet snapshot and up to twelve turns of
# history, so a stuck loop is a billing incident before it is anything else.
AI_DAILY_TOKEN_BUDGET=

# Scoped tokens for external automation against /api/dash, as
# "name:token:scope" entries, scope being read or control.
# DASHBOARD_AGENT_TOKENS="research:tok_abc:read,trader:tok_def:control"
DASHBOARD_AGENT_TOKENS=
# Disable ALL agent control at the process level. Accepts: "off" | ""
DASHBOARD_AGENT_CONTROL=
########## AI END ######

########## TRADING HEAD ##########
# The autonomous trader. Its watchlist, mode and every risk limit live in the
# database (AutopilotPolicy) and are set from the dashboard, because they are
# numbers you change while watching the desk. Nothing here can arm it — it ships
# disarmed and in observe mode, and only an explicit control call changes that.
#
# These variables govern the outside sources it reads. Both are public,
# unauthenticated and optional: with either switched off the council simply votes
# without that voice.

# TradingView's screener — a multi-timeframe technical rating computed outside
# this desk. Set to "0" to stop the daemon reaching it at all.
# Accepts: "0" | ""
TRADINGVIEW=
# Which exchange's ticker to rate. Default: BINANCE
TRADINGVIEW_EXCHANGE=
# Per-symbol overrides, for markets your venue names differently.
# TRADINGVIEW_TICKERS="BTC/USDT=OKX:BTCUSDT,PAXG/USDT=BINANCE:PAXGUSDT"
TRADINGVIEW_TICKERS=
TRADINGVIEW_TIMEOUT_MS=

# The crypto fear and greed index, used only as a contrarian brake on sizing.
# Accepts: "0" | ""
SENTIMENT=
SENTIMENT_URL=
SENTIMENT_TIMEOUT_MS=
########## TRADING HEAD END ######
