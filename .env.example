########## SHARED - ##########

# Relative to packages/prisma/src
DATABASE_URL="file:../../../dev.db"
ADMIN_PASSWORD=opentrader
# Logging level for ccxt
# Accepts: "true" | ""
CCXT_VERBOSE=
# Custom HOST. Default is localhost
HOST=
# Custom port. Default is 4000
PORT=
# Path to custom strategies dir. Should be a full path.
CUSTOM_STRATEGIES_PATH=
########## SHARED END ######

########## AI ##########
# The council's provider and model are normally set from the dashboard's AI
# settings panel, which stores them in the database and applies them live. These
# are the operational limits around it, and they are read at startup.

# Stop the AI answering or acting, without touching your own controls.
# Unlike DASHBOARD_AGENT_CONTROL=off, this leaves every operator endpoint
# working — which is what you want at the moment you are cleaning up after it.
# Accepts: "1" | ""
AI_DISABLED=

# How many actions the AI may take UNATTENDED (autopilot armed) before it has to
# be re-armed, and the rolling window that applies over. The dashboard shows a
# matching countdown, but that copy lives in a browser tab; this is the one that
# decides. Default: 20 actions per 30 minutes.
AI_AUTONOMOUS_MAX_ACTIONS=
AI_AUTONOMOUS_WINDOW_MS=

# Tokens the chat may spend per UTC day. 0 (the default) means no ceiling.
# Worth setting: every message carries a fleet snapshot and up to twelve turns of
# history, so a stuck loop is a billing incident before it is anything else.
AI_DAILY_TOKEN_BUDGET=

# Scoped tokens for external automation against /api/dash, as
# "name:token:scope" entries, scope being read or control.
# DASHBOARD_AGENT_TOKENS="research:tok_abc:read,trader:tok_def:control"
DASHBOARD_AGENT_TOKENS=
# Disable ALL agent control at the process level. Accepts: "off" | ""
DASHBOARD_AGENT_CONTROL=

# --- The MCP server's remote (Streamable HTTP) transport ----------------------
# Off by default. This serves the same tools that can close real positions, and
# a process that listens on a socket has a much larger blast radius than one that
# speaks over stdio, so turning it on must be deliberate.
#
# Once on, two things are required for ChatGPT or a phone to connect: the port
# must be reachable from the internet, and it must sit behind TLS. ChatGPT
# refuses a plain-HTTP endpoint, which is the most common reason a "working"
# server will not connect from a phone.
# MCP_HTTP_ENABLED=true
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8931

# --- Which LLM the council's strategist seat talks to --------------------
# These were the load-bearing omission in this file: every AI_* line above is a
# limit, not a provider, so an operator who set all of them correctly and never
# configured a key got a desk that answered nothing and never said so. The
# council does not fail on a missing provider - it drops to its deterministic
# seats and keeps trading - so the symptom is silence, not an error.
#
# With no key here the head still runs, and the `llm-strategist` seat is simply
# absent from the vote. `GET /api/dash/health` reports this as "not configured",
# which is a supported setup rather than a fault.
#
# Auto-detected from whichever key is present, in the order below. Set
# AI_PROVIDER to choose explicitly and pin the tier, which is worth doing when
# you hold keys for more than one of these.
# Accepts: anthropic | openai | openrouter | gemini | ollama | opencode-zen | custom
AI_PROVIDER=
# The model id to send. Left blank, each provider has a known-good default.
AI_MODEL=
# Overrides the provider's base URL. Blank uses the built-in one. Setting this
# alone, with AI_API_KEY, selects `custom` - which is how you point the council
# at a local or self-hosted OpenAI-compatible runtime.
AI_BASE_URL=
# A key for a `custom` base URL. Takes precedence over that provider's own env.
AI_API_KEY=

# Provider credentials. Any one of these is enough on its own; set the
# matching AI_PROVIDER if you hold several, or auto-detect will take the first
# one it finds in the order listed here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Gemini is read through its OpenAI-compatible endpoint, so this is the same
# key you would use for the native API.
GEMINI_API_KEY=
# OpenCode Zen and Go are one account and one key, differing only in tier - the
# code keeps a single `opencode-zen` provider and reads either variable.
OPENCODE_ZEN_API_KEY=
# A local runtime needs no key, so it is only auto-detected when its address is
# given here. It is otherwise invisible to auto-detection and silently unused.
OLLAMA_BASE_URL=

# --- LLM behaviour -------------------------------------------------------
# The strategist's own knobs. These apply whichever provider is chosen above;
# HYBRID_LLM=1 also forces the seat on for the Hybrid strategy's council.
# Accepts: "0" (off) | "1" (on) | "" (auto: on when a key is present)
HYBRID_LLM=
HYBRID_LLM_MODEL=
HYBRID_LLM_EFFORT=
HYBRID_LLM_TIMEOUT_MS=
HYBRID_LLM_MAX_TOKENS=
HYBRID_LLM_MAX_RETRIES=
########## AI END ######

########## TRADING HEAD ##########
# The autonomous trader. Its watchlist, mode and every risk limit live in the
# database (AutopilotPolicy) and are set from the dashboard, because they are
# numbers you change while watching the desk. Nothing here can arm it — it ships
# disarmed and in observe mode, and only an explicit control call changes that.
#
# These variables govern the outside sources it reads. Both are public,
# unauthenticated and optional: with either switched off the council simply votes
# without that voice.

# TradingView's screener — a multi-timeframe technical rating computed outside
# this desk. Set to "0" to stop the daemon reaching it at all.
# Accepts: "0" | ""
TRADINGVIEW=
# Which exchange's ticker to rate. Default: BINANCE
TRADINGVIEW_EXCHANGE=
# Per-symbol overrides, for markets your venue names differently.
# TRADINGVIEW_TICKERS="BTC/USDT=OKX:BTCUSDT,PAXG/USDT=BINANCE:PAXGUSDT"
TRADINGVIEW_TICKERS=
TRADINGVIEW_TIMEOUT_MS=

# The crypto fear and greed index, used only as a contrarian brake on sizing.
# Accepts: "0" | ""
SENTIMENT=
SENTIMENT_URL=
SENTIMENT_TIMEOUT_MS=
########## TRADING HEAD END ######
