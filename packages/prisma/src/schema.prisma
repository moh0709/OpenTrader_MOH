model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  displayName String?
  role        String  @default("User")

  exchangeAccounts ExchangeAccount[]
  smartTrades      SmartTrade[]
  bots             Bot[]
}

model ExchangeAccount {
  id           Int     @id @default(autoincrement())
  name         String
  label        String? @unique
  exchangeCode String // ExchangeCode

  // Credentials
  apiKey         String
  secretKey      String
  password       String?
  isDemoAccount  Boolean @default(false)
  isPaperAccount Boolean @default(false)

  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  smartTrades SmartTrade[]
  orders      Order[]

  // Will include the only the bots that uses this account as primary
  primaryBots Bot[]
  bots        Bot[] @relation(name: "AdditionalExchangeAccounts")

  expired Boolean @default(false)
}

model SmartTrade {
  id Int @id @default(autoincrement())

  type           String // SmartTradeType
  entryType      String // EntryType
  takeProfitType String // TakeProfitType

  symbol String // Optional in case of multiple symbols trading, e.g. for Triangular Arbitrage
  orders Order[]

  ref String? // user provided reference value

  exchangeAccount   ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])
  exchangeAccountId Int

  bot   Bot? @relation(fields: [botId], references: [id], onDelete: Cascade)
  botId Int?

  @@index([botId])
  @@index([ref])

  owner   User @relation(fields: [ownerId], references: [id])
  ownerId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                Int             @id @default(autoincrement())
  status            String          @default("Idle") // OrderStatus
  type              String // OrderType
  entityType        String // EntityType
  side              String // OrderSide
  price             Float? // Market orders doesn't require price to be specified
  stopPrice         Float? // If specified, then it is a Stop-Limit or Stop-Market order
  relativePrice     Float? // Percentage deviation calculated from the entry price for orders where the exact price is unknown (e.g., DCA orders)
  filledPrice       Float?
  fee               Float?
  symbol            String
  exchangeAccount   ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])
  exchangeAccountId Int

  exchangeOrderId String?

  quantity     Float
  smartTrade   SmartTrade @relation(fields: [smartTradeId], references: [id], onDelete: Cascade)
  smartTradeId Int

  // Every read of a trade fetches its orders; without this it is a table scan.
  @@index([smartTradeId])
  @@index([status, entityType])

  createdAt DateTime  @default(now())
  placedAt  DateTime?
  syncedAt  DateTime? @default(now()) // Last time the exchange Order status was synced with the DB
  filledAt  DateTime?

  updatedAt DateTime @updatedAt
}

model Bot {
  id      Int     @id @default(autoincrement())
  type    String // BotType
  name    String
  label   String? @unique
  symbol  String
  enabled Boolean @default(false)
  logging Boolean @default(true)

  // Template name that will be executed by the bot
  // e.g. `gridBot`, see templates in @opentrader/templates
  template String

  // Bot template will be executed at the candle close of specified timeframe.
  // If not specified than the template will be executed on SmartTrade filled event.
  timeframe String?

  // Means that the bot template is being processed right now.
  // This must guarantee that the bot template will not be processed
  // several times simultaneously.
  // After process finish, the value must be set back to `false`.
  processing Boolean @default(false)

  createdAt DateTime @default(now())

  /// Maximum quote-currency capital this bot may have committed at once.
  /// Null or zero means no cap. Enforced where entry orders are placed.
  maxCapital Float?
  /// Minimum quote-currency profit a cycle must make. A take profit that would
  /// earn less is lifted to the price that meets this. Null or zero means none.
  minProfit  Float?

  settings String // JSON stringified
  state    String @default("{}") // JSON stringified

  smartTrades SmartTrade[]

  exchangeAccount   ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])
  exchangeAccountId Int

  additionalExchangeAccounts ExchangeAccount[] @relation(name: "AdditionalExchangeAccounts")

  owner   User     @relation(fields: [ownerId], references: [id])
  ownerId Int
  logs    BotLog[]

  // @todo initialInvestment
}

model BotLog {
  id               Int      @id @default(autoincrement())
  action           String // type StrategyAction
  triggerEventType String? // type StrategyEventType
  context          String? // type MarketData, JSON stringified
  error            String? // type StrategyError, An error occured during the strategy execution, JSON striginfied
  startedAt        DateTime // start execution time
  endedAt          DateTime // end execution time
  createdAt        DateTime @default(now())
  bot              Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  botId            Int

  // This table grows fastest and is queried by bot and by recency. Without an
  // index both are full scans of a table that reached 729 MB on one install.
  @@index([botId, createdAt])
  @@index([createdAt])
}

model Markets {
  exchangeCode String   @id // ExchangeCode
  markets      String // JSON stringified
  updatedAt    DateTime @updatedAt
}

model PaperAsset {
  currency String @id
  balance  Float
}

model PaperOrder {
  id                 Int      @id @default(autoincrement())
  type               String // OrderType
  symbol             String
  side               String // OrderSide
  quantity           Float
  price              Float?
  filledPrice        Float?
  lastTradeTimestamp DateTime @default(now())
  status             String   @default("open") // OrderStatus
  fee                Float    @default(0)
  createdAt          DateTime @default(now())
}

/// A read-only, single-device live view of the analytics, granted to one named
/// person until a date the owner chooses. The token is derived from the
/// recipient's email and name, so each person has exactly one link.
model ShareLink {
  id    Int    @id @default(autoincrement())
  token String @unique

  name  String
  email String

  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  /// The first device to open the link claims it. Anyone else is refused.
  /// Cleared by the owner to let the recipient move to another device.
  deviceId  String?
  claimedAt DateTime?

  /// Refreshed on every heartbeat; drives the presence indicator.
  lastSeenAt DateTime?

  emailSentAt DateTime?
  emailError  String?

  /// One link per recipient: the address and name are the identity.
  @@unique([email, name])
  @@index([lastSeenAt])
}

/// Per-bot settings for the regime governor.
///
/// `baselineMaxCapital` is the operator's intent and the governor's ceiling. It
/// is held here rather than read back from `Bot.maxCapital` because the governor
/// *writes* that column — reading its own output as the next baseline would let
/// a standing bearish call ratchet the bot down to nothing over a few hours of
/// polling.
model RegimePolicy {
  botId Int @id

  /// The cap the operator chose. Null means the bot is not under management.
  baselineMaxCapital Float?
  baselineMinProfit  Float?

  /// Off means every decision resolves to baseline. The instant-revert switch.
  armed Boolean @default(true)

  /// Deepest reduction allowed, as a fraction of baseline.
  floorFactor Float @default(0.1)

  /// A conviction older than this reverts to baseline. Milliseconds.
  maxAgeMs Int @default(93600000)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Latest research conviction per symbol, mirrored from the research service.
///
/// Mirrored rather than read live so the dashboard still renders — and can show
/// how stale the reading is — when the research service is down.
model RegimeConviction {
  id Int @id @default(autoincrement())

  symbol     String
  stance     String
  confidence Float

  /// Epoch ms of the research run that produced this.
  asOf    BigInt
  summary String

  model   String?
  costUsd Float?

  /// Id of the row in the research service's own store, for the transcript link.
  sourceId Int?

  createdAt DateTime @default(now())

  /// The poller asks one question — latest per symbol — on a table that only grows.
  @@index([symbol, asOf])
}

/// One self-improvement cycle: the bot lost N trades in a row, something wrote
/// down why, and a bounded adjustment was proposed.
///
/// Nothing here is applied automatically. `status` moves proposed → applied →
/// (optionally) reverted, or proposed → dismissed, and every transition is
/// operator-initiated from the dashboard. The proposal is stored alongside the
/// settings snapshot it replaced, so a revert restores exactly what was there.
model LearningJournal {
  id Int @id @default(autoincrement())

  botId   Int
  botName String
  symbol  String

  /// Why this entry exists, e.g. `loss_streak`.
  trigger    String
  lossStreak Int

  /// The deterministic numbers the analysis was based on — win/loss amounts,
  /// average loss, sample size — as a JSON string. Kept even when an LLM wrote
  /// the narrative, so the reasoning is checkable against the arithmetic.
  stats String

  /// The post-mortem narrative.
  analysis String

  /// Proposed setting changes, JSON stringified: `{ key: newValue }`. Keys are
  /// checked against a whitelist and values clamped into bounds at apply time.
  proposal String

  /// proposed | applied | reverted | dismissed
  status String @default("proposed")

  /// Model that wrote the analysis, when one did. Null means heuristic only.
  model String?

  createdAt DateTime @default(now())
  resolvedAt DateTime?

  /// One open proposal per bot; resolved entries keep history by recency.
  @@index([botId, status])
  @@index([createdAt])
}

/// Operator-chosen LLM configuration for the AI council, set from the
/// dashboard's AI settings panel. Singleton (id = 1). The key is stored here
/// because this database already holds exchange credentials behind the same
/// login; the dashboard never echoes it back, only a mask.
model AiSettings {
  id Int @id @default(1)

  /// anthropic | openai | openrouter | gemini | ollama | opencode-zen | custom
  provider String
  model    String
  apiKey   String?
  baseUrl  String?

  updatedAt DateTime @updatedAt
}

/// One thing the AI did, kept so the feed survives a restart.
///
/// The dashboard reads a 500-entry in-process ring, which is what makes the
/// live feed instant and free. This table is the same records written through,
/// so a redeploy does not blank the AI action window and the news lane. The
/// daemon reloads the most recent rows at boot.
///
/// Applied with `prisma db push`, as `RegimePolicy`, `RegimeConviction`,
/// `LearningJournal` and `AiSettings` were: this fork's schema is the source of
/// truth and its database has no `_prisma_migrations` table to deploy against.
/// Nothing breaks if the table is absent — the daemon degrades to ring-only.
model AiAction {
  id Int @id @default(autoincrement())

  /// Epoch ms the action happened.
  at BigInt

  /// analysis | decision | open | close | take-profit | adjust | risk | cap |
  /// learning | settings | denied
  chip String

  /// info | success | warning | danger
  severity String

  botId        Int?
  botName      String?
  symbol       String?
  smartTradeId Int?

  /// Capped at the source: 48 characters for the title, 140 for the detail.
  title  String
  detail String

  /// What the dashboard should point at, JSON stringified.
  target String

  /// True when autopilot did this without anyone confirming it.
  autonomous Boolean @default(false)

  createdAt DateTime @default(now())

  /// The feed is always read newest-first, over a window.
  @@index([at])
}

/// The trading head's standing orders. Singleton (id = 1).
///
/// The head is the only thing in this system that opens and closes positions on
/// its own judgement rather than on a strategy's rules, so every number that
/// bounds it lives here, in the database, where an operator can change it
/// without a deploy and where it survives a restart.
///
/// `mode` is the switch that matters. In `observe` the head does the full
/// round — gathers, deliberates, plans, journals — and places nothing. That is
/// the default, and it is how a new watchlist or a changed limit gets a day of
/// evidence before it is allowed to spend money.
///
/// Applied with `prisma db push`, as `RegimePolicy`, `AiSettings` and `AiAction`
/// were. Nothing breaks if the table is absent: the head reports itself
/// unconfigured and does not run.
model AutopilotPolicy {
  id Int @id @default(1)

  /// Master switch. Off means the loop does not run at all.
  enabled Boolean @default(false)

  /// observe | live. Observe plans and journals but never places an order.
  mode String @default("observe")

  /// Markets to watch, JSON array of exchange symbols, e.g. ["BTC/USDT"].
  symbols String @default("[]")

  /// The bot whose exchange account, owner and credentials the head trades
  /// through. Null means it has nowhere to route an order and will not trade.
  botId Int?

  /// Seconds between passes.
  intervalSec Int @default(60)

  /// Candle timeframe the council reasons over, e.g. "15m", "1h".
  timeframe String @default("1h")

  // --- Risk budget. Every one of these can only make the head do less. ------
  equityQuote               Float @default(1000)
  maxPositionQuote          Float @default(100)
  maxTotalExposureQuote     Float @default(400)
  maxOpenPositions          Int   @default(4)
  maxDailyOpenNotionalQuote Float @default(600)
  maxDailyLossQuote         Float @default(50)
  maxConsecutiveLosses      Int   @default(3)

  /// See `HeadLimits.minConfidence` in @opentrader/ai-team for why this is not
  /// higher: the council's confidence is discounted for both disagreement and
  /// silence, so a bar of 0.6 is a head that never opens anything.
  minConfidence     Float @default(0.45)
  minExitConfidence Float @default(0.35)

  /// Smallest net profit, in quote currency, that a profit-taking exit may
  /// bank, and the floor an entry must be able to reach before it is opened at
  /// all. Risk exits — the stop and the flatten — are deliberately not gated by
  /// it: a floor on leaving a loser is how a small loss becomes an account.
  minNetProfitQuote Float @default(3)

  /// Reward has to be larger than risk.
  ///
  /// These four shipped as 1.5 / 2.5 / 1.0 / 0.5 — a 0.6:1 pairing needing a
  /// 63% win rate just to stand still, which lost money on the first live day.
  /// The code default in @opentrader/ai-team was corrected; these column
  /// defaults were not, so every fresh db push kept seeding the broken pair.
  /// They now match DEFAULT_HEAD_LIMITS, and a test holds them together.
  takeProfitPercent    Float @default(3.0)
  stopLossPercent      Float @default(2.0)
  trailStartPercent    Float @default(2.0)
  trailGivebackPercent Float @default(0.8)

  minHoldMs  Int @default(900000)
  cooldownMs Int @default(600000)
  /// Five days, in milliseconds. Beyond Int range would need BigInt; this is not.
  maxHoldMs  Int @default(432000000)

  roundTripFeeBps Float @default(55)

  allowPyramiding Boolean @default(false)
  /// Operator pause: blocks new entries, keeps managing what is open.
  killSwitch      Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// One decision by the trading head, whether or not it traded.
///
/// Written on every pass for every symbol, including the ones that resolved to
/// "hold" — a log that only records trades hides the reasoning that mattered
/// most, which is why the head stood still while the market moved.
///
/// This table is also the head's memory. Cooldowns and the daily opening budget
/// are read back from here rather than held in the process, so a restart does
/// not hand it a fresh budget or let it act twice on one idea.
model AutopilotJournal {
  id Int @id @default(autoincrement())

  /// Epoch ms the decision was made.
  at BigInt

  symbol String

  /// hold | open | add | take_profit | trail_exit | stop_out | close | flatten
  action String

  /// observe | live — what the head was allowed to do when it decided this.
  mode String

  /// True when an order actually reached the exchange for this decision.
  executed Boolean @default(false)

  /// Council confidence behind the decision, 0..1.
  confidence Float @default(0)

  /// Notional committed, for an entry.
  sizeQuote   Float?
  /// Base quantity exited, for an exit.
  quantity    Float?
  /// Reference price the decision was made at.
  price       Float?
  /// Net profit realised or estimated on an exit.
  netPnlQuote Float?

  /// The deal opened or closed, once there is one.
  smartTradeId Int?

  /// One sentence, the same words the action feed shows.
  reason String

  /// Everything the head considered, JSON stringified: the council's opinions,
  /// the external readings, and every limit that clamped the size.
  evidence String @default("{}")

  createdAt DateTime @default(now())

  /// Read newest-first, and per symbol for the cooldown check.
  @@index([at])
  @@index([symbol, at])
}
