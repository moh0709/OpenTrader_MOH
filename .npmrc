public-hoist-pattern[]=*prisma*
auto-install-peers=true

# The lockfile is read and written.
#
# It used to be disabled, which meant every install resolved the semver ranges
# in package.json afresh: two builds of the same commit, a week apart, could ship
# different versions of ccxt, fastify or the Prisma client. For a process that
# places real orders on a live exchange that is not a reproducibility nicety —
# it is the difference between deploying what you tested and deploying something
# adjacent to it.
#
# Consequence worth knowing: `pnpm install` in CI now defaults to
# --frozen-lockfile, so adding a dependency requires committing the updated
# lockfile alongside the package.json change.
lockfile=true
